# Internal service ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬ÃƒÂ¢Ã¢â€šÂ¬Ã‚Â not exposed to frontend
MONGODB_URI=mongodb://localhost:27017/doqseal
AMQP_URI=amqp://doqseal:doqseal@localhost:5672
EXTRACTION_QUEUE=extraction.jobs
STORAGE_ROOT=../storage

# Must match backend/.env AES_SECRET exactly
AES_SECRET=your_aes_secret_key_here_min_32_chars

# Extraction pipeline
# hybrid = Azure OpenAI GPT-4o vision (default) + OCR fallback for digital PDFs
# ocr_only = OCR parsing only (no vision model)
# stub = fake demo data
EXTRACTION_MODE=hybrid
VLM_PROVIDER=azure_openai
AZURE_OPENAI_ENDPOINT=https://doqseal-prod-openai.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-08-01-preview
SKIP_OCR_FOR_VISION=true
VLM_MODEL=qwen3-vl:8b
VLM_USE_4BIT=true
MAX_PDF_PAGES=3
OCR_LANGUAGES=en,hi
CONFIDENCE_THRESHOLD=0.75
# Speed (digital PDFs finish via text layer without EasyOCR/VLM)
PREFER_PDF_TEXT=true
PDF_TEXT_MIN_CHARS=180
PDF_RENDER_SCALE=1.5
SKIP_VLM_MIN_OCR_CONFIDENCE=0.72
SKIP_VLM_MIN_TEXT_CHARS=220
WARMUP_MODELS=true
WARMUP_VLM=false

# RAG indexing (Qdrant + sentence-transformers) — kept for chat context
QDRANT_URL=https://<qdrant-app>.centralindia.azurecontainerapps.io
EMBEDDING_MODEL=intfloat/multilingual-e5-base

# FastAPI health (internal)
HOST=0.0.0.0
PORT=3031

# Optional Ollama fallback (chat / vision). Prefer Azure OpenAI in prod.
OLLAMA_URL=http://localhost:11434
LLM_MODEL=qwen3-vl:8b

# Azure Blob Storage
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net

# Azure Blob Storage
AZURE_STORAGE_CONTAINER=documents

# Qdrant (Azure Container Apps)
QDRANT_API_KEY=your_qdrant_api_key
